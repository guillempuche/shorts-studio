{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!docs/vendors", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "indentStyle": "tab",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        // tsconfig's noPropertyAccessFromIndexSignature requires env["X"]; this rule would undo it.
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      // Production code never imports test helpers: src/test/ holds fakes and test setup only,
      // and the Nix package leaves it out.
      "includes": [
        "apps/*/src/**/*.ts",
        "packages/*/src/**/*.ts",
        "!**/*.test.ts",
        "!**/src/test/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/test/*", "@shorts-studio/*/test/*"],
                    "message": "src/test/ is for tests only; production code can't import it."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "json": {
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": true
    },
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  }
}
