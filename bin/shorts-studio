#!/bin/sh
# Runs the CLI from this checkout. Node strips the TypeScript types itself, so there is no
# build step. MCP clients can point here directly: `shorts-studio mcp serve`.
# In a linked worktree it runs in a sandbox, so branch code never reaches the user's posts, keys
# or paid providers (scripts/dev-sandbox.sh, docs/worktrees.md).
# realpath: when it's run through a symbolic link, the checkout is where the link points.
checkout=$(cd "$(dirname "$(realpath "$0")")/.." && pwd -P)
# shellcheck source=scripts/dev-sandbox.sh
. "$checkout/scripts/dev-sandbox.sh" || exit 2
exec node --disable-warning=ExperimentalWarning "$checkout/apps/cli/src/main.ts" "$@"
