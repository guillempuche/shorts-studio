{
  "name": "shorts-studio",
  "version": "0.1.0",
  "description": "Turn audio into vertical short videos with AI images, word-timed captions and FFmpeg: a CLI and MCP server for Reels, TikTok and YouTube Shorts.",
  "license": "Apache-2.0",
  "author": "Guillem Puche",
  "homepage": "https://github.com/guillempuche/shorts-studio#readme",
  "bugs": {
    "url": "https://github.com/guillempuche/shorts-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillempuche/shorts-studio.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.1.2",
    "@shorts-studio/domain": "workspace:*",
    "@shorts-studio/mcp": "workspace:*",
    "@shorts-studio/providers": "workspace:*",
    "@shorts-studio/usecases": "workspace:*",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@shorts-studio/tsconfig": "workspace:*",
    "@types/node": "^26.5.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "private": true
}
