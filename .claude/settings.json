{
  "permissions": {
    "allow": [
      "Skill(commit)",
      "Skill(pr)",
      "Skill(make-shorts)",
      "Bash(bin/shorts-studio config show:*)",
      "Bash(bin/shorts-studio post show:*)",
      "Bash(bin/shorts-studio post list:*)",
      "mcp__shorts-studio__config_show",
      "mcp__shorts-studio__post_list",
      "mcp__shorts-studio__post_show"
    ],
    "ask": [
      "mcp__shorts-studio__image_generate",
      "mcp__shorts-studio__audio_transcribe",
      "mcp__shorts-studio__source_transcribe",
      "Bash(*shorts-studio *image generate*)",
      "Bash(*shorts-studio *audio transcribe*)",
      "Bash(*shorts-studio *source transcribe*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/client_secret*.json)",
      "Read(**/*.p8)",
      "Bash(*shorts-studio *script approve*)",
      "Bash(*shorts-studio *post review*)",
      "Bash(*main.ts *script approve*)",
      "Bash(*main.ts *post review*)"
    ]
  },
  "claudeMdExcludes": ["**/docs/vendors/**"],
  "enabledPlugins": {
    "commit@ai-standards": true,
    "pr@ai-standards": true,
    "readability-improver@ai-standards": true,
    "test-bdd@ai-standards": true
  },
  "extraKnownMarketplaces": {
    "ai-standards": {
      "source": {
        "source": "github",
        "repo": "guillempuche/ai-standards"
      }
    }
  }
}
