{
  "name": "shorts-studio",
  "version": "0.1.0",
  "description": "Turn audio into vertical short videos with AI images, word-timed captions and FFmpeg: a CLI and MCP server for Reels, TikTok and YouTube Shorts.",
  "license": "Apache-2.0",
  "author": "Guillem Puche",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guillempuche/shorts-studio.git"
  },
  "keywords": [
    "shorts",
    "reels",
    "tiktok",
    "youtube-shorts",
    "ai-video",
    "ffmpeg",
    "whisper",
    "mcp-server",
    "effect-ts",
    "cli"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "cli": "node src/main.ts",
    "check": "biome check .",
    "lint": "biome check --write --no-errors-on-unmatched --max-diagnostics=none .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint-secrets": "secretlint \"**/*\"",
    "skills:sync": "node scripts/skills-sync.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@effect/platform-node-shared": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@types/node": "^26.5.0",
    "lefthook": "^2.0.12",
    "secretlint": "^13.0.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
