{
  "name": "shorts-studio-workspace",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "cli": "node apps/cli/src/main.ts",
    "check": "biome check . && syncpack lint",
    "check-links": "node scripts/check-links.ts",
    "check-types": "turbo run check-types && tsc --noEmit",
    "lint": "syncpack format && syncpack fix && biome check --write --no-errors-on-unmatched --max-diagnostics=none .",
    "lint-secrets": "secretlint \"**/*\"",
    "prepare": "lefthook install",
    "schemas": "node scripts/schemas.ts && biome format --write schemas",
    "skills:sync": "node scripts/skills-sync.ts",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "@shorts-studio/tsconfig": "workspace:*",
    "@types/node": "^26.5.0",
    "lefthook": "^2.0.12",
    "secretlint": "^13.0.5",
    "syncpack": "^15.3.3",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "private": true,
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
