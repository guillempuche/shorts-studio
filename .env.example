# Copy to .env (never committed) or export these in your shell.
# On macOS, keys can instead live in the Keychain; see docs/providers.md.

# Where your posts and saved collections live (default: the OS app-data folder).
SHORTS_POSTS_DIR=
# Where brand.json, config.json and the spend ledger live (default: the OS app-data folder).
SHORTS_DATA_DIR=

# Transcription (Whisper large-v3 with word timestamps)
TOGETHER_API_KEY=
# Images and image-to-video
FAL_KEY=
# Voice and music, once openspec/changes/voice-music-animate is built
ELEVENLABS_API_KEY=
FISH_API_KEY=
